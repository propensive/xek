//| mill-version: 1.1.5
//| mill-jvm-version: temurin:25
//| mill-jvm-opts: ["-XX:NonProfiledCodeHeapSize=250m", "-XX:ReservedCodeCacheSize=500m"]
//| mvnDeps: ["dev.propensive:crux-mill:0.1.4"]

package build

import mill.*
import scalalib.*
import publish.*
// crux (propensive/crux): the pinned releases on GitHub, read directly as Coursier repositories.
import crux.*

object settings:
  // The compiler is the propensive Scala fork, Proscala, at this version. XEK reads Soundness's
  // TASTy, which that compiler produced, so it compiles with the same fork. It is pinned in `deps`
  // below like the libraries and resolved from its GitHub release by crux, which also forces every
  // `org.scala-lang` artifact to it, since the pinned libraries name the release each was built
  // with. The fork stays TASTy-compatible across its patch releases, which is what that assumes.
  val scalaVersion = "3.10.0-pro-1.0.5"

  // The Soundness release XEK's Scala modules are compiled against is pinned in etc/refs and
  // read by `deps`, below. Soundness publishes one GitHub release per version whose assets are
  // the individual component jars, each embedding its own POM, which crux resolves straight from
  // the release. Component jars carry no `_3` suffix, hence the single-colon `mvn"…"`.
  //
  // This is a dependency on Soundness's *libraries*, in one direction only. Nothing in Soundness
  // depends on XEK, and nothing here depends on `ethereal`, the daemon: the two halves of an XEK
  // executable meet at `spec/`, not at a coordinate.

  // The version XEK's own jars are published under, kept equal to the release's (`X.Y.Z` from
  // 1.0.0). Snapshots override it through `publishVersion` (in `Component`), never here.
  val xekVersion = "1.0.0"

  val scalaOptions = Seq(
    // The fork's opt-in behaviours, enabled by name, exactly as the Soundness build enables
    // them: XEK's sources were written for that dialect and read TASTy produced by it.
    "-Zalias-captures",
    "-Zdiagnostic-givens",
    "-Zgiven-prefixes",
    "-Zinline-source-maps",
    "-Zopaque-mutability",
    "-Zpure-iarrays",
    "-Zretains-bounds",
    "-Zretains-skolems",
    "-Zspreadable-varargs",
    "-Zunboxed-pure-types",
    "-Zunion-captures",
    "-experimental",
    "-new-syntax",
    "-feature",
    "-preview",
    "-deprecation",
    "-Wunused:imports",
    "-Wimplausible-patterns",
    "-Xmax-inlines", "32",
    "-Yno-flexible-types",
    "-Yexplicit-nulls",
    "-Ycheck-all-patmat",
    "-language:experimental.modularity",
    "-language:experimental.dependent",
    "-language:experimental.relaxedLambdaSyntax",
    "-language:experimental.genericNumberLiterals",
    "-language:experimental.into",
    "-language:experimental.erasedDefinitions",
    "-language:implicitConversions",
    "-language:experimental.saferExceptions",
    "-language:experimental.strictEqualityPatternMatching",
    "-language:experimental.subCases",
    "-language:experimental.multiSpreads")

  // Capture checking, and capture plus separation checking. Soundness rolls these out
  // module-by-module and each module here compiles under exactly the tier its sources were
  // written and checked under: the packager under `sep`; the builder (`core`, whose work is
  // `java.nio` byte arrays and streams), the `xek` command and the suite under neither; and the
  // toolchain edge (which passes a capturing `edit` function through `Toolchain.Setting`, and
  // implements a `Tool` whose signature is not capture-annotated) under neither.
  def cc(options: Seq[String]): Seq[String] =
    options ++ Seq("-Ycc-new", "-language:experimental.captureChecking")

  def sep(options: Seq[String]): Seq[String] =
    cc(options) :+ "-language:experimental.separationChecking"

  // XEK's sources are written for the proscenium predef (the Soundness house predef), so the
  // build replicates `-Yno-predef -Yimports:…`. `scala` is deliberately NOT imported: the
  // blessed collections are proscenium's opaque `List`/`Set`/`Map`/`Array`, and naming both
  // packages would make every such reference ambiguous.
  val predef = Seq("-Yno-predef", "-Yimports:java.lang,proscenium")

  // Every Soundness component XEK's modules reach directly, at the version `v` (the pin, read
  // by a module's task). Each jar's embedded POM names its own dependencies, so the rest of the
  // surface arrives transitively.
  class Soundness(v: String):

    // `xek.core`: the builder itself — the record, stub resolution, assembly and the polyglot
    // launchers. Byte-level work goes through `java.nio`; these give it paths, text and resources.
    val core = Seq(
      mvn"dev.propensive:galilei-jvm:$v",        // paths
      mvn"dev.propensive:ambience-core:$v",      // the system properties paths are read with
      mvn"dev.propensive:gossamer-core:$v",      // text
      mvn"dev.propensive:hieroglyph-core:$v",    // UTF-8 for resources
      mvn"dev.propensive:hellenism-core:$v",     // classpath resources (templates, `Client`)
      mvn"dev.propensive:turbulence-core:$v")    // reading resources

    // `xek.cli`: the `xek` command itself, an XEK executable daemonized through `ethereal`, with
    // its arguments and tab-completions from `exoskeleton`.
    val cli = Seq(
      mvn"dev.propensive:ethereal-core:$v",
      mvn"dev.propensive:exoskeleton-completions:$v",
      mvn"dev.propensive:exoskeleton-manpage:$v", // `xek install` writes the manpage
      mvn"dev.propensive:revolution-semver:$v",   // the version in the manpage's header
      mvn"dev.propensive:ambience-core:$v")      // the invocation's environment

    // `xek.toolchain`: the `Jar` → executable edge of an Anthology toolchain.
    val toolchain = Seq(
      mvn"dev.propensive:anthology-linker:$v",   // Jar, Toolchain, Edge, Tool
      mvn"dev.propensive:parasite-core:$v")      // Monitor

    // `xek.test`.
    val test = Seq(
      mvn"dev.propensive:guillotine-core:$v",    // running the files it builds
      mvn"dev.propensive:eucalyptus-core:$v",    // logging for those subprocesses
      mvn"dev.propensive:probably-cli:$v",       // Suite
      mvn"dev.propensive:probably-events:$v",    // the BinTEL event stream a host client reads
      mvn"dev.propensive:spectacular-core:$v",   // `show`
      mvn"dev.propensive:escapade-core:$v",      // Teletype
      mvn"dev.propensive:profanity-core:$v",     // termcaps
      mvn"dev.propensive:digression-ansi:$v",    // stack-trace diagnostics
      mvn"dev.propensive:inimitable-core:$v",    // Uuid, for scratch filenames
      mvn"dev.propensive:stratiform-core:$v")    // the schema signature, derived from spec/ (BinTEL lives in stratiform-core since 0.69.0)

    // `xek.example`: the end-to-end fixture, and the ONLY place the daemon appears. It is not a
    // dependency of any published XEK artifact — see the module's comment.
    val example = Seq(
      mvn"dev.propensive:ethereal-core:$v",
      mvn"dev.propensive:exoskeleton-completions:$v")

// One module per source directory under `src`, with its resources under `res/<module>`, mirroring
// the Soundness layout the sources came from.

// The propensive libraries this build depends on, pinned in etc/refs (the format, the snapshot flow
// and the shared scripts are documented in propensive/.github): each is a release `X.Y.Z`, or a
// snapshot `X.Y.Z-<12 hex>` of an unreleased upstream build, published there by `make snapshot`.
// crux resolves each — and, transitively, what each was built against — from its GitHub release;
// nothing is installed locally. The Proscala pin is declared here rather than in etc/refs, which
// the scripts at `etc/github-ref` also read and which do not know the form of a Proscala version.
// The file is read as a source, so editing it invalidates every resolution.
object deps extends CruxModule:
  def refsFiles = Task.Sources(mill.api.BuildCtx.workspaceRoot / "etc" / "refs")
  def declared = Seq(Pin("propensive/proscala", settings.scalaVersion))

  def soundness: T[String] = Task(version("soundness")())

trait Component(dependencies: PublishModule*) extends CruxScalaModule, PublishModule:
  def crux = deps
  override def scalacOptions = settings.scalaOptions ++ settings.predef
  def moduleId: String = moduleDir.last
  override def moduleDeps: Seq[PublishModule] = dependencies
  override def sources = Task.Sources(moduleDir)
  // `res/<module>` is both a runtime resource root and a *compile* resource root: hellenism's
  // `cp"…"` interpolator resolves a classpath path at compile time, so a template the generator
  // reads must be visible to the compiler, not merely packaged into the jar.
  override def resources = Task.Sources(moduleDir / os.up / os.up / "res" / moduleId)
  override def compileResources = Task.Sources(moduleDir / os.up / os.up / "res" / moduleId)

  // The beneficence compiler plugin writes the `META-INF/givens/<typeclass>` and
  // `META-INF/services/probably.Suite` index entries Soundness's runtime and test discovery read.
  override def scalacPluginMvnDeps = Task(Seq(
    mvn"dev.propensive:beneficence-plugin:${deps.soundness()}"
      .exclude("org.scala-lang" -> "scala-library")))

  // Those indexes are *fragments* of a build-wide index, one per contributing module. Mill's
  // default assembly rules are last-one-wins, which silently truncates them; concatenate instead,
  // exactly as the Soundness build does. Every fragment ends with a newline, so the empty
  // separator is correct.
  override def assemblyRules = super.assemblyRules ++ Seq(
    mill.javalib.Assembly.Rule.AppendPattern("META-INF/givens/.*"),
    mill.javalib.Assembly.Rule.AppendPattern("META-INF/services/.*"))

  // A `Task.Input` reading `Task.env`, not a plain value: `XEK_RELEASE_VERSION` is how
  // `make snapshot` (snapshot.sh in propensive/.github) drives the snapshot version through a
  // Mill daemon that is already running — the daemon freezes `sys.env` at its own start, while
  // `Task.env` is the environment of each `./mill` invocation. A release sets it to the tag's
  // version, which an assembled release is versioned by; `settings.xekVersion` is kept equal.
  def publishVersion = Task.Input:
    Task.env.get("XEK_RELEASE_VERSION").filter(_.nonEmpty).getOrElse(settings.xekVersion)
  def artifactSuffix = Task("")

  def pomSettings = Task(PomSettings(
    description = "XEK: JVM applications as single executable files",
    organization = "dev.propensive",
    url = "https://github.com/propensive/xek/",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("propensive", "xek"),
    developers = Seq(Developer("propensive", "Jon Pretty", "https://github.com/propensive"))))

  override def artifactName = Task(s"xek-$moduleId")

object xek extends Module:
  override def moduleDir = super.moduleDir / os.up / "src"

  // The builder: the ETHRCFG record, the client stubs (resolved from a local directory, or
  // downloaded, verified and cached), native assembly, and the polyglot launchers — a single
  // file that is at once a valid `sh` script, a `.bat` file and a PowerShell script, which
  // unpacks or downloads the executable for the platform it finds itself on. The single
  // implementation of the builder's side of `spec/ethrcfg.md`.
  //
  // Compiled without capture checking, like `toolchain`: its work is byte arrays and streams
  // from `java.nio`, which the checker can only be told about by casting.
  object core extends Component():
    def mvnDeps = Task(settings.Soundness(deps.soundness()).core)

  // Turning a `Packaging` into a distributable, through `core`.
  object packager extends Component(core):
    def mvnDeps = Task(Seq.empty[Dep])
    override def scalacOptions = settings.sep(super.scalacOptions())

  // The same packaging reached as an Anthology toolchain format, so an application can be
  // compiled and packaged in one path rather than packaged as a separate step afterwards.
  object toolchain extends Component(packager):
    def mvnDeps = Task(settings.Soundness(deps.soundness()).toolchain)

  // `xek`, the command: `core` behind a command line, and itself an XEK executable, daemonized
  // through Soundness's `ethereal` like any other. Its `bootstrap` entry point runs `core` from
  // a plain JVM, with no launcher, which is how the first `xek` executable is built.
  object cli extends Component(core):
    def mvnDeps = Task(settings.Soundness(deps.soundness()).cli)
    override def artifactName = Task("xek-cli")
    override def mainClass = Some("xek.command")

    // The JAR is appended to a stub as it is, so it starts with the ZIP itself, not with a shell
    // script to run it.
    override def prependShellScript = ""

    // `xek --version` reads the version it was built as from `xek/cli.version`.
    def version = Task:
      os.write(Task.dest / "xek" / "cli.version", publishVersion(), createFolders = true)
      PathRef(Task.dest)

    override def resources = Task(super.resources() ++ Seq(version()))

    // Soundness's `stenography` depends on the Scala compiler for its macros, so the compiler
    // and its dependencies reach the runtime classpath, as do the TASTy files a compiler reads.
    // `xek` runs no macros and reads no TASTy, and they would be most of the bytes of every copy
    // of it, so they are left out of the executable's JAR.
    override def assemblyRules = super.assemblyRules ++ Seq(
      mill.javalib.Assembly.Rule.ExcludePattern("dotty/.*"),
      mill.javalib.Assembly.Rule.ExcludePattern("scala/tools/.*"),
      mill.javalib.Assembly.Rule.ExcludePattern("scala/quoted/runtime/impl/.*"),
      mill.javalib.Assembly.Rule.ExcludePattern("xsbti/.*"),
      mill.javalib.Assembly.Rule.ExcludePattern("org/jline/.*"),
      mill.javalib.Assembly.Rule.ExcludePattern("coursierapi/.*"),
      mill.javalib.Assembly.Rule.ExcludePattern(".*\\.tasty"))

    // Runs `xek` from this module's assembly with no launcher, through its `bootstrap` entry
    // point, on the JVM Mill runs with: `xek` built by `xek`. Takes the command line `xek` takes,
    // with paths relative to the repository, as in `./mill xek.cli.bootstrap build --polyglot
    // --client dist/client out/xek/cli/assembly.dest/out.jar dist/xek`.
    def bootstrap(arguments: mainargs.Leftover[String]) = Task.Command:
      val jar = assembly().path
      val java = mill.util.Jvm.javaExe(javaHome().map(_.path))

      os.proc(java, "-cp", jar.toString, "xek.bootstrap", arguments.value)
       .call(cwd = mill.api.BuildCtx.workspaceRoot, stdout = os.Inherit, stderr = os.Inherit)

      PathRef(jar)

    // Writes `dist/xek`, the `xek` command as an embed-all polyglot file for every platform
    // (and `dist/xek.cmd`, the same bytes, for cmd.exe). The stubs are the ones in
    // `dist/client` when that exists (`make client-build`, or `make client-fetch`), and
    // otherwise the published release named in `res/core/xek/client.*`, downloaded and
    // verified. A command rather than a target, since `dist/client` is outside the build: it
    // is cheap once the assembly is cached.
    def executable() = Task.Command:
      val root = mill.api.BuildCtx.workspaceRoot
      val jar = assembly().path
      val java = mill.util.Jvm.javaExe(javaHome().map(_.path))
      val client = root / "dist" / "client"
      val output = root / "dist" / "xek"
      val local = if os.exists(client) then Seq("--client", client.toString) else Nil
      val arguments = Seq("build", "--polyglot", jar.toString, output.toString) ++ local

      os.proc(java, "-cp", jar.toString, "xek.bootstrap", arguments)
       .call(cwd = root, stdout = os.Inherit, stderr = os.Inherit)

      os.copy.over(output, root / "dist" / "xek.cmd")
      PathRef(output)

  // Suites have no `main` of their own: a host client discovers them from the
  // `META-INF/services/probably.Suite` index the beneficence plugin writes, and drives them
  // over the BinTEL test-event protocol. `make test` assembles this module and runs
  // `fume run -c …` over the assembly, exactly as Soundness runs its own suites.
  object test extends Component(core, packager, toolchain):
    def mvnDeps = Task(settings.Soundness(deps.soundness()).test)
    override def artifactName = Task("xek-test")

    // The protocol schema and the client's copy of its signature are read off the classpath,
    // so the suite can compare them wherever its host client's working directory happens
    // to be.
    def contract = Task.Sources(
      mill.api.BuildCtx.workspaceRoot / "spec",
      mill.api.BuildCtx.workspaceRoot / "src" / "client" / "src")
    override def resources = Task(super.resources() ++ contract())

  // The end-to-end fixture: a real daemonized application, packaged by the modules above and run
  // through a real client stub. This is the ONE module that depends on a daemon implementation
  // (Soundness's `ethereal`), because the other end of the protocol has to be *something* for an
  // end-to-end test to exist. It is deliberately outside every aggregate — nothing published
  // from this repository depends on it, and `mill xek.packager.compile` and the test suite never
  // resolve it. `make e2e` is what builds it.
  //
  // Like every module here it compiles against the Soundness *release* in etc/refs, so it may
  // not use daemon API that only the next Soundness release will have (AGENTS.md, rule 6):
  // Soundness pins XEK's release, and a fixture that needed unreleased Soundness would leave
  // neither side able to release first.
  object example extends Component():
    def mvnDeps = Task(settings.Soundness(deps.soundness()).example)
    override def artifactName = Task("xek-example")
    def finalMainClass = "xek.hello"

  // Everything published from this repository. Note the absence of `example`.
  def all = Task:
    core.compile()
    packager.compile()
    cli.compile()
    toolchain.compile()
    test.compile()
