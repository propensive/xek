tel 1.0 propensive.dev/bolt

# Bolt codes of XEK: `subdivision 1` / `error 8` is ↯/x.1.8. Subdivision 1 is the
# launcher which begins every XEK executable, so its codes are reported by the
# applications built with XEK; the others are reported by the `xek` command and
# the libraries behind it.
#
# This is the record of the letter `x` which the index of bolt codes, `projects.tel` in
# propensive/bolt, names; its schema is `bolt.tel` there. A code, once assigned, is permanent:
# a number is never reused, and one which is withdrawn stays, marked `retired`.

project x xek

  subdivision 1 launcher
    summary  the native launcher at the start of an XEK executable (src/client)
    error 1 executable-not-located
      summary  the launcher could not locate its own executable
      source src/client/src/main.rs
    error 2 state-directory-unusable
      summary  the application's state directory cannot be used
      source src/client/src/main.rs
    error 3 java-options-ignored
      summary  Java options were given, but the daemon is already running with different ones (a warning)
      source src/client/src/main.rs
    error 4 session-refused
      summary  the daemon ended the session without answering: it speaks another launcher protocol
      source src/client/src/main.rs
    error 5 session-dropped
      summary  the daemon ended the session without reporting the exit status
      source src/client/src/main.rs
    error 6 socket-untrusted
      summary  the daemon's socket is owned by, or open to, another user
      source src/client/src/main.rs
    error 7 schema-mismatch
      summary  the daemon speaks another launcher protocol: its schema is not this launcher's
      source src/client/src/main.rs
    error 8 java-not-found
      summary  no suitable version of Java was found
      source src/client/src/java.rs
    error 9 no-downloader
      summary  Java could not be downloaded: neither curl nor wget is on the PATH
      source src/client/src/java.rs
    error 10 java-download-failed
      summary  the download of Java failed
      source src/client/src/java.rs
    error 11 java-unpack-failed
      summary  unpacking the download of Java failed
      source src/client/src/java.rs
    error 12 java-release-missing
      summary  the download of Java contains no `release` file
      source src/client/src/java.rs
    error 13 java-version-unreadable
      summary  the version of Java could not be read from its `release` file
      source src/client/src/java.rs
    error 14 java-not-moved
      summary  the downloaded Java could not be moved into place
      source src/client/src/java.rs
    error 15 daemon-not-started
      summary  the daemon failed to start
      source src/client/src/state.rs
    error 16 daemon-unreachable
      summary  the daemon could not be reached at its socket
      source src/client/src/state.rs
    error 17 daemon-process-failed
      summary  the daemon process failed to start, and left its failure marker
      source src/client/src/state.rs

